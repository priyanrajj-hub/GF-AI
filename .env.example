# ========================================================
# Ada Holographic AI Companion - Environment Configuration
# ========================================================

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --------------------------------------------------------
# 1. LLM Cloud & Local Providers (Free Tiers First)
# --------------------------------------------------------

# Primary LLM: Google Gemini (Free tier available)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_SECONDARY=your_secondary_gemini_key_for_failover
GEMINI_MODEL=gemini-flash-lite-latest

# Groq Cloud Inference (Free tier ultra-fast LPU)
# Get key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (Free community models)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Hugging Face Inference Providers (Free serverless)
# Create a fine-grained, read-only token at: https://huggingface.co/settings/tokens
HF_ACCESS_KEY_ID=your_huggingface_read_token_here
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_TTS_MODEL=hexgrad/Kokoro-82M

# Local Ollama (100% Private Offline Inference - Zero Cloud Leakage)
# Install from: https://ollama.com
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --------------------------------------------------------
# 2. Text-to-Speech (TTS) & Voice Models
# --------------------------------------------------------
# High-fidelity Neural Voice: ElevenLabs
# Free tier premade voice: cgSgspJ2msm6clMCkdW9 (Jessica)
# Paid custom clone: NOpBlnGInO9m6vDvFkFC
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=NOpBlnGInO9m6vDvFkFC
ELEVENLABS_MODEL_ID=eleven_v4

# --------------------------------------------------------
# 3. 3D Generative AI & Integrations
# --------------------------------------------------------
# Tripo3D API for auto-rigged humanoid generation
TRIPO_API_KEY=your_tripo_api_key_here

# --------------------------------------------------------
# 4. Data Persistence & Security
# --------------------------------------------------------
DATA_DIR=./data
JWT_SECRET=super_secret_ada_jwt_key
