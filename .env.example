# ========================================================
# Ada Holographic AI Companion - Environment Configuration
# ========================================================

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Primary LLM: Google Gemini (Recommended & Free tier available)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Alternative LLM: Anthropic Claude
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Pluggable Text-to-Speech (TTS) Providers:
# Free default: Browser SpeechSynthesis (requires no API key)
# High-fidelity optional: ElevenLabs (https://elevenlabs.io)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Speech-to-Text (STT) Providers:
# Free default: Web Speech API (built into browser, no key needed)
# High-accuracy optional: OpenAI Whisper fallback API
OPENAI_API_KEY=

# Data persistence directory (defaults to server/data/)
DATA_DIR=./data
