# ========================================================
# GF-AI Core Environment Configuration Template
# ========================================================
# Copy this file to .env and supply actual deployment values.
# NEVER commit real .env files to source control!

# ── Server Configuration ─────────────────────────────────
PORT=3001
NODE_ENV=development
APP_URL=https://gf-ai-ochre.vercel.app
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://gf-ai-ochre.vercel.app
STRICT_ENV_VALIDATION=false

# ── Authentication & Security ───────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=development-insecure-jwt-secret-key-at-least-32-chars-length
REFRESH_SECRET=development-insecure-refresh-secret-key-at-least-32-chars-length
AUTH_SECRET=development-insecure-jwt-secret-key-at-least-32-chars-length
ADMIN_EMAILS=admin@example.com
ENABLE_TEST_AUTH=false

# ── Durable Relational Database ─────────────────────────
# PostgreSQL in Docker / Production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=development_postgres_password_1234
POSTGRES_DB=gf_ai
# PostgreSQL / Neon Connection String
DATABASE_URL=
# Redis Cache
REDIS_URL=redis://localhost:6379
# Turso / libSQL (Optional cloud alternative)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
LIBSQL_URL=

# ── LLM Providers ───────────────────────────────────────
# Google Gemini (Primary Multi-Key Rotation Pool)
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud Inference (Ultra-Fast LPU)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter Gateway
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Hugging Face Serverless Inference
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_TTS_MODEL=hexgrad/Kokoro-82M

# Local Offline Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Speech & Voice Synthesis ────────────────────────────
# ElevenLabs (Optional Neural Voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Hatsune Miku Enterprise Gateway (Crypton / Yamaha)
MIKU_VOICE_ENABLED=false
MIKU_VOICE_API_URL=https://api.vocaloid.example.com/v1/synthesize
MIKU_VOICE_API_KEY=
MIKU_VOICE_MODEL=vocaloid6-miku-official
MIKU_VOICE_LICENSE_STATUS=unlicensed

# ── Transactional Email & Magic Links ────────────────────
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=auth@example.com

# ── Market Data & Financial Feeds ───────────────────────
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# ── 3D Generative AI ────────────────────────────────────
TRIPO_API_KEY=
