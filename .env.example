# ========================================================
# Ada Holographic AI Companion - Environment Configuration
# ========================================================
# Copy this file to .env and fill in your values.
# Never commit .env to source control!

# ── Server Configuration ─────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# JWT secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super_secret_ada_jwt_key
DATA_DIR=./data

# ── Vercel (auto-injected at runtime, set in dashboard) ──
VERCEL_URL=your-app.vercel.app

# ─────────────────────────────────────────────────────────
# 1. LLM Cloud & Local Providers (Free Tiers First)
# ─────────────────────────────────────────────────────────

# Primary LLM: Google Gemini (Free tier available)
# Get a free key at: https://aistudio.google.com/app/apikey
# Multi-key rotation pool (comma-separated list for failover & high availability):
GEMINI_API_KEYS=your_first_gemini_key,your_second_gemini_key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_MODEL=gemini-3.5-flash

# Groq Cloud Inference (Free tier ultra-fast LPU)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=get_free_at_console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (Free community models gateway)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=get_free_at_openrouter.ai
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Hugging Face Inference Providers (Free serverless)
# Create a fine-grained read-only token at: https://huggingface.co/settings/tokens
HF_TOKEN=get_free_at_huggingface.co
HF_ACCESS_KEY_ID=your_huggingface_read_token_here
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_TTS_MODEL=hexgrad/Kokoro-82M

# Local Ollama (100% Private Offline Inference — Zero Cloud Leakage)
# Install from: https://ollama.com
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ─────────────────────────────────────────────────────────
# 2. Text-to-Speech (TTS) & Voice Models
# ─────────────────────────────────────────────────────────
# High-fidelity Neural Voice: ElevenLabs (optional premium)
# Free tier premade voice: cgSgspJ2msm6clMCkdW9 (Jessica)
# Paid custom clone: NOpBlnGInO9m6vDvFkFC
ELEVENLABS_API_KEY=optional_premium_voices
ELEVENLABS_VOICE_ID=NOpBlnGInO9m6vDvFkFC
ELEVENLABS_MODEL_ID=eleven_v4

# ─────────────────────────────────────────────────────────
# 3. Financial & Market Data APIs (Optional)
# ─────────────────────────────────────────────────────────
# Alpha Vantage (stock quotes & financial data)
# Get free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=get_free_at_alphavantage.co

# Finnhub (real-time market data)
# Get free key at: https://finnhub.io/register
FINNHUB_KEY=get_free_at_finnhub.io

# NewsAPI (live news headlines)
# Get free key at: https://newsapi.org/register
NEWS_API_KEY=get_free_at_newsapi.org

# ─────────────────────────────────────────────────────────
# 4. 3D Generative AI & Integrations (Optional)
# ─────────────────────────────────────────────────────────
# Tripo3D API for auto-rigged humanoid generation
TRIPO_API_KEY=your_tripo_api_key_here
